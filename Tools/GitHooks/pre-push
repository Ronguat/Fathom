#!/usr/bin/env bash
# pre-push -- refuses branch deletions and non-fast-forward pushes from this clone.
#
# Git hands each ref being pushed on stdin as: <local ref> <local sha> <remote ref> <remote sha>.
# A deletion has an all-zero local sha; a rewrite is a remote sha that is not an ancestor of the
# local one. Either aborts the whole push. The remote's ruleset enforces the same two rules; this
# copy fails faster and works against any remote.
#
# Installed into .git/hooks by Tools/GitHooks/install-hooks.sh; hooks are not versioned by git.
# The refs are read once and handed on to git-lfs, which pushes the objects the commits need.
set -u
ZERO=0000000000000000000000000000000000000000
rc=0
refs=$(cat)
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_ref:-}" ] && continue
  if [ "$local_sha" = "$ZERO" ]; then
    echo "pre-push: refusing to delete $remote_ref" >&2; rc=1; continue
  fi
  if [ "$remote_sha" != "$ZERO" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    echo "pre-push: refusing non-fast-forward push to $remote_ref" >&2; rc=1
  fi
done <<EOF
$refs
EOF
[ "$rc" -eq 0 ] || exit $rc
if command -v git-lfs >/dev/null 2>&1; then
  printf '%s
' "$refs" | git lfs pre-push "$@"
  exit $?
fi
exit 0
